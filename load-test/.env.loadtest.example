# ── MOISAM Load Test Environment Variables ──
# 이 파일을 .env로 복사한 뒤 실제 값을 채워서 사용하세요.
# GCP VM에서는 이 파일의 실제 값을 기반으로 컨테이너가 실행됩니다.

# [Security]
JWT_SECRET_KEY=your_jwt_secret_key_here
BATCH_SECRET_KEY=your_batch_secret_key_here

# [External API Keys]
# 실제 API를 호출하지 않고 WireMock을 사용하더라도, 앱 기동을 위해 형식적인 값이 필요합니다.
KAKAO_API_KEY=your_kakao_api_key
ODSAY_API_KEY=your_odsay_api_key
SEOUL_OPEN_API_KEY=your_seoul_api_key

# [Notifications & Mail]
MAIL_PASSWORD=your_gmail_app_password
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# [Database]
POSTGRES_DB=moisam
POSTGRES_USER=moisam
POSTGRES_PASSWORD=moisam
